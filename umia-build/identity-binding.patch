+import { hexlify, Wallet } from 'ethers'
+
+import { inputContext } from '#src/tests/utils/claim-context.ts'
+
+// Records carry plaintext; the transcript decryption, oprf-raw replacement, HTTP provider and
+// identity check under test are the real code. IDENTITY_REAL_OPRF=1 runs the gnark OPRF with
+// generated keys (needs the ZK files and a supported architecture); otherwise sha256 stands in.
+const REAL_OPRF = process.env.IDENTITY_REAL_OPRF === '1'
+let currentHost = 'example.com'
+mock.module('#src/server/utils/process-handshake.ts', {
+	namedExports: {
+		async processHandshake() {
+			return { tlsVersion: 'TLS1_3', cipherSuite: 'TLS_CHACHA20_POLY1305_SHA256', hostname: currentHost, nextMsgIndex: 0 }
+		}
+	}
+})
+const actualZk = await import('#src/utils/zk.ts')
+mock.module('#src/utils/zk.ts', {
+	namedExports: {
+		...actualZk,
+		async verifyZkPacket({ ciphertext, zkReveal }: any) {
+			return { redactedPlaintext: ciphertext.slice(), oprfRawMarkers: zkReveal.oprfRawMarkers }
+		}
+	}
+})
+if(REAL_OPRF) {
+	const { logger } = await import('#src/utils/logger.ts')
+	const { shares } = await actualZk.makeDefaultOPRFOperator('chacha20', 'gnark', logger).generateThresholdKeys(2, 1)
+	process.env.TOPRF_SHARE_PRIVATE_KEY = hexlify(shares[0].privateKey)
+	process.env.TOPRF_SHARE_PUBLIC_KEY = hexlify(shares[0].publicKey)
+} else {
+	mock.module('#src/server/utils/oprf-raw.ts', {
+		namedExports: {
+			async computeOPRFRaw(plaintext: Uint8Array, markers: { dataLocation: { fromIndex: number, length: number } }[]) {
+				return markers.map(({ dataLocation }) => ({
+					dataLocation,
+					nullifier: new Uint8Array(createHash('sha256').update(plaintext.subarray(dataLocation.fromIndex, dataLocation.fromIndex + dataLocation.length)).digest())
+				}))
+			}
+		}
+	})
+}
+
+const [
+	{ assertValidClaimRequest },
+	{ providers },
+	{ AttestorError },
+	{ rejectionReason },
+	{ binaryHashToStr, hashProviderParams },
+	{ SIGNATURES },
+	{ computeOPRFRaw },
