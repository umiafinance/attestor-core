+	const other = { ...GITHUB, params: { ...GITHUB.params, paramValues: { github_actor_id: '58217470' } } }
+	assert.notDeepEqual(await claim(other, githubBody('58217470'), [at(githubBody('58217470'), '58217470')]), { github_actor_id: expected })
