+}
+const fomoBody = (clan = '"clan":{"id":"75c4e351-f125-4714-b843-d592985ba534","name":"Les Français"},') =>
+	`{"responseObject":{"id":"${FOMO_USER}","address":"0xabc",${clan}"handle":"GiantTallSmelt"}}`
+
+// A future recipe with two identities and a plain fact capture.
+const MULTI: Recipe = {
+	host: 'example.com',
+	params: {
+		url: 'https://example.com/me',
+		method: 'GET',
+		responseMatches: [
+			{ type: 'contains', value: '"user":"{{user_id}}"' },
+			{ type: 'contains', value: '"org":"{{org_id}}"' },
+			{ type: 'regex', value: '"plan":"(?<plan>[a-z]+ [a-z]+)"' }
+		],
+		responseRedactions: [
+			{ hash: 'oprf-raw', regex: '"user":"(?<user_id>[0-9]+)"' },
+			{ hash: 'oprf-raw', regex: '"org":"(?<org_id>[0-9]+)"' },
+			{ regex: '"plan":"(?<plan>[a-z]+ [a-z]+)"' }
