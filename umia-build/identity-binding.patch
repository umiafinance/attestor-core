+		method: 'GET',
+		responseMatches: [
+			{ type: 'contains', value: String.raw`\"GroupUUID\":\"${ECHO_GROUP}\",\"UserUUID\":\"{{echo_user}}\",\"State\":\"accepted\"` },
+			{ type: 'regex', value: String.raw`\\"isMember\\":true` }
