+}
+const echoGroupsBody = String.raw`<script>self.__next_f.push("{\"isMember\":true,\"joinRequest\":{\"UUID\":\"4a1b2c3d-0000-4000-8000-000000000000\",\"GroupUUID\":\"${ECHO_GROUP}\",\"UserUUID\":\"${ECHO_USER}\",\"State\":\"accepted\"}}")</script>`
+const ECHO_PROFILE: Recipe = {
+	host: 'app.echo.xyz',
+	params: {
+		url: 'https://app.echo.xyz/account/profile',
+		method: 'GET',
+		responseMatches: [
+			{ type: 'contains', value: String.raw`\"EntityUUID\":\"{{echo_user}}\",\"EntityType\":\"user\",\"Provider\":\"sumsub\",\"Type\":\"standard-kyc\",\"State\":\"completed\"` }
+		],
+		responseRedactions: [
+			{ hash: 'oprf-raw', regex: String.raw`\\"EntityUUID\\":\\"(?<echo_user>[0-9a-f-]{36})\\",\\"EntityType\\":\\"user\\",\\"Provider\\":\\"sumsub\\",\\"Type\\":\\"standard-kyc\\",\\"State\\":\\"completed\\"` }
+		],
+		paramValues: { echo_user: ECHO_USER }
+	}
+}
+const echoProfileBody = String.raw`<script>self.__next_f.push("{\"Complete\":[{\"UUID\":\"7c8d9e0f-0000-4000-8000-000000000000\",\"EntityUUID\":\"${ECHO_USER}\",\"EntityType\":\"user\",\"Provider\":\"sumsub\",\"Type\":\"standard-kyc\",\"State\":\"completed\"}]}")</script>`
+
+// fomo-clans/clan-member: the profile URL carries two secret parts and one reviewed public fragment
+const FOMO_USER = 'c0ffee12-3456-4abc-8def-0123456789ab'
+const FOMO_FRAGMENT = FOMO_USER.slice(14)
+const FOMO_CURRENT: Recipe = {
+	host: 'prod-api.fomo.family',
+	params: {
+		url: 'https://prod-api.fomo.family/v2/users/current',
+		method: 'GET',
+		responseMatches: [{ type: 'contains', value: '"responseObject":{"id":"{{fomo_user}}","address":"' }],
+		responseRedactions: [{ hash: 'oprf-raw', regex: '"responseObject":\\{"id":"(?<fomo_user>[0-9a-f-]{36})","address":"' }],
+		paramValues: { fomo_user: FOMO_USER }
+	}
+}
+const FOMO_PROFILE: Recipe = {
+	host: 'prod-api.fomo.family',
+	params: {
+		url: 'https://prod-api.fomo.family/v2/users/{{URL_PARAM_1_SECRET}}-{{URL_PARAM_2_SECRET}}-{{fomo_url_fragment}}',
+		method: 'GET',
+		responseMatches: [
