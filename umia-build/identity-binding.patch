+}
+const MULTI_BODY = '{"user":"1001","org":"77","plan":"pro plan","handle":"neo","last_user":"1001"}'
+
+const EMAIL = 'alice@example.org'
+// The bench Google recipe's shape: the match does not delimit the value.
+const EMAIL_RECIPE: Recipe = {
+	host: 'example.com',
+	params: {
+		url: 'https://example.com/profile',
+		method: 'GET',
+		responseMatches: [{ type: 'contains', value: '{{email}}' }],
+		responseRedactions: [{ regex: '"(?<email>[^"\\\\\\s@]+@[^"\\\\\\s@]+)"', hash: 'oprf-raw' }],
+		paramValues: { email: EMAIL }
+	}
+}
+const EMAIL_BODY = `{"email":"${EMAIL}"}`
+
+async function nullifier(text: string) {
+	const data = encoder.encode(text)
+	const [{ nullifier }] = await computeOPRFRaw(data, [{ dataLocation: { fromIndex: 0, length: data.length } }], logger)
+	return binaryHashToStr(nullifier, data.length)
+}
+
+function record(plaintext: Uint8Array) {
+	const content = new Uint8Array([...plaintext, 0x17])
+	return new Uint8Array([0x17, 0x03, 0x03, content.length >> 8, content.length & 0xff, ...content])
+}
+
+function response(body: string) {
+	const bytes = encoder.encode(body)
+	return encoder.encode(`HTTP/1.1 200 OK\r\nContent-Length: ${bytes.length}\r\n\r\n${body}`)
+}
+
+/** Marker over `text` inside the nth `occurrence` of the response. */
+function at(body: string, text: string, occurrence = text, nth = 0): Marker {
+	const responseText = decoder.decode(response(body))
+	let index = -1
+	for(let i = 0; i <= nth; i++) {
+		index = responseText.indexOf(occurrence, index + 1)
+		assert.ok(index >= 0, occurrence)
+	}
+
+	const fromIndex = index + occurrence.indexOf(text)
+	assert.ok(fromIndex >= index, text)
+	return { fromIndex: encoder.encode(responseText.slice(0, fromIndex)).length, length: encoder.encode(text).length }
+}
+
+async function claim(
+	{ host, params, secretParams }: Recipe,
+	body: string,
+	markers: Marker[] = [],
+	{ splitAt, hide = [] }: { splitAt?: number, hide?: Marker[] } = {}
+) {
+	currentHost = host
+	const request = providers.http.createRequest({ headers: { Cookie: 'session=test' }, ...secretParams }, params as any, logger)
+	const requestBytes = (request.data as Uint8Array).slice()
+	for(const { fromIndex, toIndex } of request.redactions) {
+		requestBytes.fill(0x2a, fromIndex, toIndex)
+	}
+
+	const responseBytes = response(body)
+	// Bytes the proof does not reveal reach the attestor as the redaction character.
+	for(const { fromIndex, length } of hide) {
+		responseBytes.fill(0x2a, fromIndex, fromIndex + length)
+	}
+
+	const records = splitAt ? [responseBytes.slice(0, splitAt), responseBytes.slice(splitAt)] : [responseBytes]
+	const reveals = records.map(() => ({ oprfRawMarkers: [] as Marker[], overshotOprfRawLength: 0 }))
+	let offset = 0
+	const bounds = records.map(bytes => ({ start: offset, end: offset += bytes.length }))
+	for(const marker of markers) {
+		const i = bounds.findIndex(({ start, end }) => marker.fromIndex >= start && marker.fromIndex < end)
+		assert.ok(i >= 0, 'marker inside the response')
+		reveals[i].oprfRawMarkers.push({ fromIndex: marker.fromIndex - bounds[i].start, length: marker.length })
+		const overshot = marker.fromIndex + marker.length - bounds[i].end
+		if(overshot > 0) {
+			reveals[i + 1].overshotOprfRawLength = overshot
+		}
+	}
+
+	const zkReveal = (reveal = { oprfRawMarkers: [] as Marker[], overshotOprfRawLength: 0 }) => ({
+		proofs: [{ startIdx: 0 }],
+		oprfRawMarkers: reveal.oprfRawMarkers.map(dataLocation => ({ dataLocation })),
+		overshotOprfRawLength: reveal.overshotOprfRawLength
+	})
+	const SERVER = proto.TranscriptMessageSenderType.TRANSCRIPT_MESSAGE_SENDER_TYPE_SERVER
+	const unsigned = proto.ClaimTunnelRequest.create({
+		request: { id: 1, host, port: 443 },
+		data: {
+			provider: 'http',
+			parameters: JSON.stringify(params),
+			context: inputContext(),
+			owner: owner.address.toLowerCase(),
+			timestampS: Math.floor(Date.now() / 1000)
+		},
+		transcript: [
+			{ sender: proto.TranscriptMessageSenderType.TRANSCRIPT_MESSAGE_SENDER_TYPE_CLIENT, message: record(requestBytes), reveal: { zkReveal: zkReveal() } },
+			...records.map((bytes, i) => ({ sender: SERVER, message: record(bytes), reveal: { zkReveal: zkReveal(reveals[i]) } }))
+		]
+	})
+	const signature = await SIGNATURES[ETH].sign(proto.ClaimTunnelRequest.encode(unsigned).finish(), owner.privateKey)
+	const signed = { ...unsigned, signatures: { requestSignature: signature } }
+	// The final layer authorizes provider hashes here; earlier layers ignore the argument.
+	const info = await (assertValidClaimRequest as any)(signed, metadata, logger, [hashProviderParams(params as any)])
+	return JSON.parse(info.context).extractedParameters as Record<string, string>
+}
+
+async function expectRejected(reason: string, action: Promise<unknown>) {
+	await assert.rejects(action, (err: unknown) => {
+		assert.ok(err instanceof AttestorError, String(err))
+		assert.equal(rejectionReason(err), reason, String(err))
+		return true
+	})
+}
