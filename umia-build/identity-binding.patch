+}
+
+// echo-groups/west-ham-verified-member: identity regexes verbatim, the facts shortened
+const ECHO_USER = '0f6a4c2e-9b1d-4e7a-8c3f-2d5b6e7f8a9b'
+const ECHO_GROUP = '336b2d8f-e40d-401b-8c98-5b9b23558cfb'
+const ECHO_GROUPS: Recipe = {
