+] = await Promise.all([
+	import('#src/server/utils/assert-valid-claim-request.ts'),
+	import('#src/providers/index.ts'),
+	import('#src/utils/error.ts'),
+	import('#src/utils/rejection-reason.ts'),
+	import('#src/utils/index.ts'),
+	import('#src/utils/signatures/index.ts'),
+	import('#src/server/utils/oprf-raw.ts'),
+	import('#src/proto/api.ts')
+])
+
+const ETH = proto.ServiceSignatureType.SERVICE_SIGNATURE_TYPE_ETH
+const VERSION = proto.AttestorVersion.ATTESTOR_VERSION_3_2_0
+const metadata = { signatureType: ETH, clientVersion: VERSION } as any
+const logger = { info() {}, debug() {}, warn() {}, error() {}, trace() {}, child() { return logger } } as any
+const owner = Wallet.createRandom()
+const encoder = new TextEncoder()
+const decoder = new TextDecoder()
+
+type Recipe = { host: string, params: Record<string, any>, secretParams?: Record<string, any> }
+type Marker = { fromIndex: number, length: number }
+
+// github-2026q3/maintainer-50-stars-actor-id-v1.0.1
+const ACTOR_ID = '58217469'
+const GITHUB: Recipe = {
+	host: 'github.com',
+	params: {
+		url: 'https://github.com/search?q=user%3A%40me%20stars%3A%3E%3D50%20is%3Apublic&type=repositories',
+		method: 'GET',
+		// The extension always sends an empty geoLocation.
+		geoLocation: '',
+		responseMatches: [
+			{ type: 'contains', value: '<meta name="octolytics-actor-id" content="{{github_actor_id}}" />' },
+			{ type: 'regex', value: '"result_count":(?:[1-9][0-9]*)\\b' }
+		],
+		responseRedactions: [
