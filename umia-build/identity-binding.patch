+			{ hash: 'oprf-raw', regex: String.raw`\\"GroupUUID\\":\\"${ECHO_GROUP}\\",\\"UserUUID\\":\\"(?<echo_user>[0-9a-f-]{36})\\",\\"State\\":\\"accepted\\"` },
+			{ regex: String.raw`\\"isMember\\":true` }
