+		],
+		responseRedactions: [
+			{ hash: 'oprf-raw', regex: '"responseObject":\\{"id":"(?<fomo_user>[0-9a-f-]{36})","address":"' },
+			{ regex: '"clan":\\{"id":"(?:75c4e351-f125-4714-b843-d592985ba534|2c2e5343-ee46-4476-bd6f-238eb25ab9b7)","name":"' }
