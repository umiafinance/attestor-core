-	const bodyOff = pos - bodyStart
-	let acc = 0
-	for(const c of chunks) {
-		const cf = c.fromIndex - synthLen
-		const ct = c.toIndex - synthLen
-		if(bodyOff >= cf && bodyOff < ct) {
-			return bodyStart + acc + (bodyOff - cf)
-		}
-
-		if(bodyOff === ct) {
-			return bodyStart + acc + (ct - cf)
-		}
-
-		acc += ct - cf
-	}
