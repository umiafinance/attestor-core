-function concatenateParts(parts: Uint8Array[]): Uint8Array {
-	const length = parts.reduce((total, part) => total + part.length, 0)
-	const result = new Uint8Array(length)
-	let offset = 0
-	for(const part of parts) {
-		result.set(part, offset)
-		offset += part.length
-	}
-	return result
-}
