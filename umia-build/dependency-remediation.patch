-		}
-
-		const hasEmbeddedKeys = (bundle.teekSigned!.ethAddress && bundle.teekSigned!.ethAddress.length > 0) &&
-			(bundle.teetSigned!.ethAddress && bundle.teetSigned!.ethAddress.length > 0)
-
-		if(!hasEmbeddedKeys) {
