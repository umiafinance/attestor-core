+		['127.255.255.255', false],
+		['169.254.169.254', false],
+		['100.64.0.1', false],
+		['100.127.255.255', false],
+		['192.0.2.1', false],
+		['198.51.100.1', false],
+		['203.0.113.1', false],
+		['198.18.0.1', false],
