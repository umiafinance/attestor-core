-		body: parser.res.body ?? new Uint8Array(),
-		chunks: parser.res.chunks.map(chunk => ({
-			fromIndex: chunk.fromIndex + bodyStart - DECHUNK_SYNTH_HEADER.length,
-			toIndex: chunk.toIndex + bodyStart - DECHUNK_SYNTH_HEADER.length,
-		})),
