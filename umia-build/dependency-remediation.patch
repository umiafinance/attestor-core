-
-	const hash = TPM_HASH_TO_NODE[rd.u16()]
-	if(!hash) {
-		throw new Error('GCP quote signature hash algorithm unsupported')
-	}
-
-	return { r: rd.tpm2b(), s: rd.tpm2b(), hash }
-}
