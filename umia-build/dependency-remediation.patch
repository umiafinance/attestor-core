-				logger.info(`V2 cross-binding: T->K expected=${teetExpectsKV2} actual=${teekKeyResult.pcr0}; K->T expected=${teekExpectsT} actual=${teetKeyResult.pcr0}`)
-
-				if(teetExpectsKV2 !== teekKeyResult.pcr0) {
