-	if(rd.u32() !== TPM_GENERATED) {
-		throw new Error('quote missing TPM_GENERATED magic')
-	}
-
-	if(rd.u16() !== TPM_ST_ATTEST_QUOTE) {
-		throw new Error('attestation is not a TPM quote')
-	}
