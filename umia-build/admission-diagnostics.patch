+		authIdentity: TEST_SESSION_ID,
+		authHostWhitelist: ['example.com'],
+		metadata: { signatureType: ETH, clientVersion: proto.AttestorVersion.ATTESTOR_VERSION_3_2_0 },
+		tunnels: {},
+		assertAuthActive() {},
+		getTunnel() { return tunnel() },
+		removeTunnel() {},
+		...overrides
+	}
