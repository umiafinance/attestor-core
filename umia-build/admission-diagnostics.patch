+			assert.equal(assertSupportedInputContext(raw('84532'), TEST_SESSION_ID, ['84532', '10143']).reclaimSessionId, TEST_SESSION_ID)
+			assert.throws(() => assertSupportedInputContext(raw('84532'), TEST_SESSION_ID, TEST_CHAIN_IDS), (err: unknown) => rejectionReason(err) === 'CLAIM_CONTEXT_CHAIN_NOT_ALLOWED')
