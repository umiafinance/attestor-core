+import { canonicalStringify } from '#src/utils/claims.ts'
+import { AttestorError } from '#src/utils/error.ts'
+
+const INPUT_KEYS = ['contextAddress', 'contextMessage', 'reclaimSessionId']
+const SIGNED_KEYS = [...INPUT_KEYS, 'providerHash', 'extractedParameters']
+const RESERVED_EXTRACTED_KEYS = new Set([...SIGNED_KEYS, 'attestationNonce', 'attestationNonceData'])
+const ADDRESS = /^0x[a-f0-9]{40}$/
+const HASH = /^0x[a-f0-9]{64}$/
+const DECIMAL = /^(0|[1-9][0-9]*)$/
+const MESSAGE = /^[\x20-\x21\x23-\x5b\x5d-\x7e]+$/
+const EXTRACTED_KEY = /^[a-z][a-z0-9_]{0,63}$/
+const UUID_V4 = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/
+
+type InputContext = {
+	contextAddress: string
+	contextMessage: string
+	reclaimSessionId: string
+}
+
+function invalid(): never {
+	throw AttestorError.badRequest('Unsupported claim context')
+}
+
+function parseCanonicalObject(raw: unknown, keys: readonly string[]): Record<string, unknown> {
+	if(typeof raw !== 'string') return invalid()
+	let value: unknown
+	try {
+		value = JSON.parse(raw)
+	} catch {
+		return invalid()
+	}
+	if(!value || typeof value !== 'object' || Array.isArray(value)) return invalid()
+	const context = value as Record<string, unknown>
+	const actualKeys = Object.keys(context)
+	if(actualKeys.length !== keys.length || actualKeys.some(key => !keys.includes(key))) return invalid()
+	// A canonical byte comparison also rejects duplicate raw JSON keys before signing.
+	if(canonicalStringify(context) !== raw) return invalid()
+	return context
+}
+
+function assertAuctionMessage(value: unknown): asserts value is string {
+	if(typeof value !== 'string' || !MESSAGE.test(value)) return invalid()
+	const parts = value.split(':')
+	if(parts[1] !== '10143' || !ADDRESS.test(parts[2] ?? '')) return invalid()
+	if(parts[0] === 'register' && parts.length === 4 && parts[3]) return
+	if(parts[0] === 'bid' && parts.length === 6
+		&& DECIMAL.test(parts[3]) && DECIMAL.test(parts[4]) && parts[5]) return
+	return invalid()
+}
+
+// Generation-only sandbox challenge bound to the session wallet. The hook only accepts
+// register:/bid: prefixes, so a sandbox claim can never satisfy an auction.
+export function isSandboxContextMessage(value: unknown, contextAddress: string): value is string {
+	if(typeof value !== 'string') return false
+	const parts = value.split(':')
+	return parts.length === 4 && parts[0] === 'sandbox' && parts[1] === '10143'
+		&& parts[2] === contextAddress && UUID_V4.test(parts[3])
+}
+
+export function assertSupportedInputContext(raw: unknown, authIdentity: string | undefined): InputContext {
+	const input = parseCanonicalObject(raw, INPUT_KEYS)
+	if(typeof input.contextAddress !== 'string' || !ADDRESS.test(input.contextAddress)) return invalid()
+	if(!isSandboxContextMessage(input.contextMessage, input.contextAddress)) {
+		assertAuctionMessage(input.contextMessage)
+	}
+	if(!authIdentity || input.reclaimSessionId !== authIdentity) return invalid()
+	return {
+		contextAddress: input.contextAddress,
+		contextMessage: input.contextMessage,
+		reclaimSessionId: authIdentity
+	}
+}
+
+export function assertSupportedSignedContext(raw: unknown, input: InputContext): void {
+	if(typeof raw !== 'string') return invalid()
+	const signed = parseCanonicalObject(raw, SIGNED_KEYS)
+	for(const key of INPUT_KEYS) {
+		if(signed[key] !== input[key]) return invalid()
+	}
+	if(typeof signed.providerHash !== 'string' || !HASH.test(signed.providerHash)) return invalid()
+	const extracted = signed.extractedParameters
+	if(!extracted || typeof extracted !== 'object' || Array.isArray(extracted)) return invalid()
+	const entries = Object.entries(extracted)
+	if(!entries.length || entries.some(([key, value]) =>
+		!EXTRACTED_KEY.test(key) || RESERVED_EXTRACTED_KEYS.has(key)
+		|| typeof value !== 'string' || !value.trim().length)) return invalid()
+
+	// Claims.sol reads the first raw target, so each must identify this top-level value.
+	for(const key of ['contextAddress', 'contextMessage', 'providerHash'] as const) {
+		const target = `"${key}":"`
+		if(raw.indexOf(target) !== raw.lastIndexOf(target)) return invalid()
+		const start = raw.indexOf(target) + target.length
+		if(start < target.length || raw.slice(start, raw.indexOf('"', start)) !== signed[key]) return invalid()
+	}
+	const target = '"extractedParameters":'
+	if(raw.indexOf(target) !== raw.lastIndexOf(target)) return invalid()
+	const start = raw.indexOf(target) + target.length
+	if(start < target.length || !raw.startsWith(canonicalStringify(extracted), start)) return invalid()
+}
diff --git a/src/server/utils/host-policy.ts b/src/server/utils/host-policy.ts
new file mode 100644
index 0000000..7953a55
--- /dev/null
+++ b/src/server/utils/host-policy.ts
@@ -0,0 +1,89 @@
+import { isIP } from 'node:net'
+
+import type { ProviderClaimInfo } from '#src/proto/api.ts'
+import { canonicalStringify } from '#src/utils/claims.ts'
+import { AttestorError } from '#src/utils/error.ts'
+
+const MAX_DNS_NAME_LENGTH = 253
+const DNS_LABEL = /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/
+
+export function isCanonicalAuthHostname(host: unknown): host is string {
+	if(typeof host !== 'string' || host.length > MAX_DNS_NAME_LENGTH || isIP(host)) return false
+	if(host === 'localhost' || ['.localhost', '.local', '.internal'].some(suffix => host.endsWith(suffix))) return false
+	const labels = host.split('.')
+	if(labels.length < 2 || !labels.every(label => DNS_LABEL.test(label))) return false
+	try {
+		const url = new URL(`https://${host}`)
+		return url.hostname === host && !isIP(url.hostname)
+	} catch {
+		return false
+	}
+}
+
+export function assertCanonicalHostWhitelist(hostWhitelist: readonly string[]) {
+	if(!Array.isArray(hostWhitelist) || !hostWhitelist.length) {
+		throw AttestorError.badRequest('Authenticated host list is empty')
+	}
+	let previous: string | undefined
+	for(const entry of hostWhitelist) {
+		if(!isCanonicalAuthHostname(entry) || (previous !== undefined && previous >= entry)) {
+			throw AttestorError.badRequest('Authenticated host list is not canonical')
+		}
+		previous = entry
+	}
+}
+
+export function assertAuthenticatedTunnelHost(
+	hostWhitelist: readonly string[],
+	host: string,
+	port: number
+) {
+	assertCanonicalHostWhitelist(hostWhitelist)
+	if(port !== 443) throw AttestorError.badRequest('Authenticated tunnel requires port 443')
+	if(!hostWhitelist.includes(host)) throw AttestorError.badRequest('Host not allowed by auth request')
+}
+
+export function assertAuthenticatedClaimAuthority(
+	claim: ProviderClaimInfo,
+	hostWhitelist: readonly string[],
+	tunnelHost: string | undefined,
+	tunnelPort: number | undefined
+) {
+	if(!tunnelHost || tunnelPort === undefined) {
+		throw AttestorError.badRequest('Authenticated claim has no recorded tunnel authority')
+	}
+	assertAuthenticatedTunnelHost(hostWhitelist, tunnelHost, tunnelPort)
+	if(claim.provider !== 'http') {
+		throw AttestorError.badRequest('Authenticated claim provider is unsupported')
+	}
+
+	let params: unknown
+	try {
+		params = JSON.parse(claim.parameters)
+	} catch {
+		throw AttestorError.badRequest('Authenticated claim URL is invalid')
+	}
+	if(!params || typeof params !== 'object' || Array.isArray(params)
+		|| canonicalStringify(params) !== claim.parameters) {
+		throw AttestorError.badRequest('Authenticated claim parameters are not canonical')
+	}
+	const urlText = (params as { url?: unknown }).url
+	if(typeof urlText !== 'string') {
+		throw AttestorError.badRequest('Authenticated claim URL is invalid')
+	}
+	// Check raw authority before URL parsing can normalize case, IDNA, or default port.
+	const authority = /^https:\/\/([^/?#]+)(?:[/?#]|$)/.exec(urlText)?.[1]
+	if(authority !== tunnelHost && authority !== `${tunnelHost}:443`) {
+		throw AttestorError.badRequest('Authenticated claim authority differs from tunnel')
+	}
+	let url: URL
+	try {
+		url = new URL(urlText)
+	} catch {
+		throw AttestorError.badRequest('Authenticated claim URL is not canonical HTTPS on port 443')
+	}
+	if(
+		url.protocol !== 'https:' || url.hostname !== tunnelHost || url.port !== ''
+		|| url.username || url.password || url.hash
+	) throw AttestorError.badRequest('Authenticated claim URL is not canonical HTTPS on port 443')
+}
