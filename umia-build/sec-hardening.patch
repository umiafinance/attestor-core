diff --git a/src/server/utils/stwo-proof-compression.ts b/src/server/utils/stwo-proof-compression.ts
new file mode 100644
index 0000000..b964722
--- /dev/null
+++ b/src/server/utils/stwo-proof-compression.ts
@@ -0,0 +1,37 @@
+import { inflateSync } from 'node:zlib'
+import { ZKProofEngine, type ClaimTunnelRequest } from '#src/proto/api.ts'
+import { AttestorError } from '#src/utils/index.ts'
+
+const MAGIC = Buffer.from('UMIA_STWO_ZLIB_V1\0')
+const MAX_PROOF_BYTES = 4 * 1024 * 1024
+const MAX_TOTAL_PROOF_BYTES = 32 * 1024 * 1024
+
+/** Called only after the signed request has been verified. */
+export function restoreStwoProofs(request: ClaimTunnelRequest) {
+	let totalBytes = 0
+	for(const packet of request.transcript) {
+		for(const proof of packet.reveal?.zkReveal?.proofs ?? []) {
+			const encoded = proof.proofData
+			if(encoded.length >= MAGIC.length
+				&& Buffer.compare(encoded.subarray(0, MAGIC.length), MAGIC) === 0) {
+				if(request.zkEngine !== ZKProofEngine.ZK_ENGINE_STWO) {
+					throw AttestorError.badRequest('Compressed proof requires Stwo')
+				}
+				try {
+					proof.proofData = inflateSync(encoded.subarray(MAGIC.length), {
+						maxOutputLength: MAX_PROOF_BYTES
+					})
+				} catch {
+					throw AttestorError.badRequest('Invalid compressed proof')
+				}
+			}
+			if(proof.proofData.length > MAX_PROOF_BYTES) {
+				throw AttestorError.badRequest('Proof too large')
+			}
+			totalBytes += proof.proofData.length
+			if(totalBytes > MAX_TOTAL_PROOF_BYTES) {
+				throw AttestorError.badRequest('Total proof bytes too large')
+			}
+		}
+	}
+}
diff --git a/src/tests/stwo-proof-compression.test.ts b/src/tests/stwo-proof-compression.test.ts
new file mode 100644
index 0000000..bb1444a
--- /dev/null
+++ b/src/tests/stwo-proof-compression.test.ts
@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict'
+import { deflateSync } from 'node:zlib'
+import { it } from 'node:test'
+import { ClaimTunnelRequest, ZKProofEngine } from '#src/proto/api.ts'
+import { restoreStwoProofs } from '#src/server/utils/stwo-proof-compression.ts'
+
+const magic = Buffer.from('UMIA_STWO_ZLIB_V1\0')
+function request(proofData: Uint8Array, engine = ZKProofEngine.ZK_ENGINE_STWO) {
+	return ClaimTunnelRequest.create({
+		zkEngine: engine,
+		transcript: [{ reveal: { zkReveal: { proofs: [{ proofData }] } } }]
+	})
+}
+
+it('restores compressed Stwo proofs and accepts legacy proof bytes', () => {
+	const raw = new Uint8Array(200_000).fill(0x41)
+	const compressed = request(Buffer.concat([magic, deflateSync(raw)]))
+	restoreStwoProofs(compressed)
+	assert.equal(Buffer.compare(compressed.transcript[0].reveal?.zkReveal?.proofs[0].proofData ?? new Uint8Array(), raw), 0)
+	const legacy = request(raw)
+	restoreStwoProofs(legacy)
+	assert.equal(legacy.transcript[0].reveal?.zkReveal?.proofs[0].proofData, raw)
+})
+
+it('rejects compressed proofs for another engine and bounded decompression', () => {
+	const raw = new Uint8Array(4 * 1024 * 1024 + 1).fill(0x41)
+	const encoded = Buffer.concat([magic, deflateSync(raw)])
+	assert.throws(() => restoreStwoProofs(request(encoded, ZKProofEngine.ZK_ENGINE_SNARKJS)))
+	assert.throws(() => restoreStwoProofs(request(encoded)))
+	assert.throws(() => restoreStwoProofs(request(Buffer.concat([magic, new Uint8Array([1, 2, 3])]))))
+})
