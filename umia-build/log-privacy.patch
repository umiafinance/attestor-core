+const [loggerModule, { AttestorClient }, { WS_PATHNAME }, { createServer }, { getRandomPort }, { createAuthRequest }, { claimTunnel }, { claimTeeBundle }, proto] = await Promise.all([
+	import('#src/utils/logger.ts'),
